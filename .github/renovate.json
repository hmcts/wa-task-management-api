{
  "timezone": "Europe/London",
  "platformAutomerge": false,
  "automergeSchedule": ["* 9-15 * * 1-5"],
  "minimumReleaseAge": "30 days",
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "schedule": "after 7am and before 11am every weekday",
  "extends": [
    "local>hmcts/.github:renovate-config"
  ],
  "labels": [
    "dependencies"
  ],
  "helmv3": {
    "bumpVersion": "patch"
  },
  "regexManagers": [
    {
      "fileMatch": [
        "^Dockerfile$"
      ],
      "matchStrings": [
        "datasource=(?<datasource>.*?) depName=(?<depName>.*?)( versioning=(?<versioning>.*?))?\\sARG .*?_VERSION=(?<currentValue>.*)\\s"
      ]
    }
  ],
  "prCreation": "not-pending",
  "automergeType": "pr",
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true
    },
    {
      "matchDatasources": [
        "terraform-module",
        "terraform-provider"
      ],
      "prPriority": 10,
      "automerge": false,
      "groupName": "Terraform Upgrades"
    },
    {
      "matchPackagePrefixes": [
        "org.springframework",
        "io.spring"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "prPriority": 80,
      "automerge": true,
      "groupName": "Spring Upgrade - Non Major"
    },
    {
      "matchPackagePatterns": [
        "serenity",
        "pitest",
        "pact"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "prPriority": 20,
      "automerge": true,
      "groupName": "QA & Nightly Checks - Non Major"
    },
    {
      "matchPackagePatterns": [
        "hmcts:java-logging",
        "log4j",
        "slf4j"
      ],
      "prPriority": 30,
      "groupName": "Logging Dependencies"
    },
    {
      "matchPackagePatterns": [
        "dependencycheck",
        "sonarqube",
        "checkstyle",
        "jacoco"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "prPriority": 20,
      "groupName": "Automated Checks - Non Major"
    },
    {
      "matchPackagePrefixes": [
        "org.assertj",
        "org.junit",
        "org.mockito",
        "com.h2database",
        "org.testcontainers"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "prPriority": 20,
      "groupName": "Testing Dependencies - Non Major"
    }
  ]
}
